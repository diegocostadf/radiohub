{
  "appId": "br.radiohub.app",
  "productName": "RadioHub",
  "copyright": "© 2026 Diego Costa",
  "directories": { "output": "dist/installers" },
  "win": { "signAndEditExecutable": false, "icon": "build/icon.ico" },
