    "installerLanguages": ["pt_BR"],
    "language": "1046",
    "license": "LICENSE",
    "artifactName": "RadioHub-Setup-win-${env.RH_ARCH}.exe",
    "deleteAppDataOnUninstall": false
  },
  "publish": null
