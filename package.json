{
  "name": "radiohub",
  "productName": "RadioHub",
  "version": "0.3.0",
  "description": "Gestão de rádios com os drivers do CHIRP e assistente de frequências com IA",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Diego Costa",
    "email": "contato@diegocosta.digital",
    "url": "https://www.diegocosta.digital"
  },
  "scripts": {
    "start": "electron .",
    "package:mac-arm64": "electron-packager . RadioHub --platform=darwin --arch=arm64 --icon=build/icon.icns --app-bundle-id=br.radiohub.app --extra-resource=pybuild/darwin-arm64/python --out=dist --overwrite --extra-resource=engine --ignore=^/dist --ignore=^/python --ignore=^/engine --ignore=^/build --ignore=^/tests --ignore=^/pybuild --ignore=^/\\.github --ignore=^/README.md --ignore=^/LICENSE",
    "package:mac-x64": "electron-packager . RadioHub --platform=darwin --arch=x64 --icon=build/icon.icns --app-bundle-id=br.radiohub.app --extra-resource=pybuild/darwin-x64/python --out=dist --overwrite --extra-resource=engine --ignore=^/dist --ignore=^/python --ignore=^/engine --ignore=^/build --ignore=^/tests --ignore=^/pybuild --ignore=^/\\.github --ignore=^/README.md --ignore=^/LICENSE",
    "package:win-x64": "electron-packager . RadioHub --platform=win32 --arch=x64 --extra-resource=pybuild/win32-x64/python --out=dist --overwrite --extra-resource=engine --ignore=^/dist --ignore=^/python --ignore=^/engine --ignore=^/build --ignore=^/tests --ignore=^/pybuild --ignore=^/\\.github --ignore=^/README.md --ignore=^/LICENSE",
    "package:win-ia32": "electron-packager . RadioHub --platform=win32 --arch=ia32 --extra-resource=pybuild/win32-ia32/python --out=dist --overwrite --extra-resource=engine --ignore=^/dist --ignore=^/python --ignore=^/engine --ignore=^/build --ignore=^/tests --ignore=^/pybuild --ignore=^/\\.github --ignore=^/README.md --ignore=^/LICENSE"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "37.2.0",
    "electron-builder": "^24.13.3",
    "pe-library": "^0.4.1",
    "resedit": "^1.7.2"
  },
  "homepage": "https://www.diegocosta.digital",
  "radiohub": {
    "updateRepo": "diegocostadf/radiohub"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diegocostadf/radiohub.git"
  },
  "bugs": {
    "url": "https://github.com/diegocostadf/radiohub/issues",
    "email": "contato@diegocosta.digital"
  }
}